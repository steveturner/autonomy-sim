# Optional. Enables Google Photorealistic 3D Tiles in 3D mode.
# Without it, 3D mode uses the Cesium globe with the configured satellite imagery.
VITE_GOOGLE_MAPS_API_KEY=

# Tokenless Esri World Imagery is the default satellite basemap.
# Other supported sources are bing-aerial, bing-labels, and sentinel-2; those
# sources, plus Cesium World Terrain in 3D, require an ion access token.
VITE_IMAGERY_SOURCE=esri
VITE_CESIUM_ION_TOKEN=

# Use a custom ArcGIS MapServer by keeping source=esri, or a {z}/{x}/{y} tile
# template by setting source=url. Leave blank for the built-in Esri endpoint.
# VITE_IMAGERY_URL=https://example.test/tiles/{z}/{x}/{y}.png

# Vite binds to loopback by default. Set only for trusted-LAN demos.
# VITE_BIND_HOST=0.0.0.0

# By default the API host is the hostname used to open the page, on port 9000.
# Override either the authority or complete HTTP base URL for split-host setups.
# VITE_API_HOST=sim-host.local:9000
# VITE_API_URL=http://sim-host.local:9000

# Lowest-level override for an exact WebSocket endpoint.
# VITE_WS_URL=ws://127.0.0.1:9000/api/v1/stream
