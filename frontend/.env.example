# Optional. Without this key, 3D mode uses the normal Cesium globe.
VITE_GOOGLE_MAPS_API_KEY=

# Vite binds to loopback by default. Set only for trusted-LAN demos.
# VITE_BIND_HOST=0.0.0.0

# By default the API host is the hostname used to open the page, on port 9000.
# Override either the authority or complete HTTP base URL for split-host setups.
# VITE_API_HOST=sim-host.local:9000
# VITE_API_URL=http://sim-host.local:9000

# Lowest-level override for an exact WebSocket endpoint.
# VITE_WS_URL=ws://127.0.0.1:9000/api/v1/stream
